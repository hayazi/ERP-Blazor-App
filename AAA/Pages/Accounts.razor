@page "/aaa/accounts"
@using ERPBlazorApp.AAA.Services
@using ERPBlazorApp.AAA.Models
@using MudBlazor
@inject AccountService AccountService

<PageTitle>Accounts</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <MudText Typo="Typo.h6">Chart of Accounts</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddAccount">Add Account</MudButton>
            </div>

            @if (accounts == null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                <MudDataGrid T="Account" Items="accounts" Filterable="true" ShowColumnOptions="true" Sortable="true" EditMode="DataGridEditMode.Cell">
                    <Columns>
                        <PropertyColumn T="Account" TProperty="int" Property="x => x.Id" Title="ID" />
                        <PropertyColumn T="Account" TProperty="string" Property="x => x.Code" Title="Code" />
                        <PropertyColumn T="Account" TProperty="string" Property="x => x.Name" Title="Name" />
                        <PropertyColumn T="Account" TProperty="string" Property="x => x.Type" Title="Type" />
                        <PropertyColumn T="Account" TProperty="string" Property="x => x.ParentAccount!.Name" Title="Parent Account" />
                        <PropertyColumn T="Account" TProperty="bool" Property="x => x.IsActive" Title="Active">
                            <CellTemplate Context="account">
                                <MudBadge Color="account.Item.IsActive ? Color.Success : Color.Error" Content="@(account.Item.IsActive ? "Active" : "Inactive")" />
                            </CellTemplate>
                        </PropertyColumn>
                        <TemplateColumn T="Account" Title="Actions">
                            <CellTemplate Context="account">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAccount(account.Item)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAccount(account.Item.Id)" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager PageSizeOptions="new int[] { 5, 10, 20 }" />
                    </PagerContent>
                </MudDataGrid>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@if (showDialog)
{
    <div class="modal" style="display:block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingAccount == null ? "Add" : "Edit") Account</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input class="form-control" @bind="editingAccount!.Code" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="editingAccount!.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select class="form-select" @bind="editingAccount!.Type">
                            <option value="Asset">Asset</option>
                            <option value="Liability">Liability</option>
                            <option value="Equity">Equity</option>
                            <option value="Revenue">Revenue</option>
                            <option value="Expense">Expense</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Parent Account</label>
                        <select class="form-select" @bind="editingAccount!.ParentAccountId">
                            <option value="">None</option>
                            @foreach (var acc in accounts!)
                            {
                                <option value="@acc.Id">@acc.Code - @acc.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" @bind="editingAccount!.IsActive" id="activeCheck" />
                        <label class="form-check-label" for="activeCheck">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveAccount">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Account>? accounts;
    private bool showDialog = false;
    private Account? editingAccount;

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        accounts = AccountService.GetAll();
    }

    private void AddAccount()
    {
        editingAccount = new Account { IsActive = true };
        showDialog = true;
    }

    private void EditAccount(Account account)
    {
        editingAccount = new Account
        {
            Id = account.Id,
            Code = account.Code,
            Name = account.Name,
            Type = account.Type,
            ParentAccountId = account.ParentAccountId,
            IsActive = account.IsActive
        };
        showDialog = true;
    }

    private void SaveAccount()
    {
        if (editingAccount == null) return;

        if (editingAccount.Id == 0)
        {
            AccountService.Add(editingAccount);
        }
        else
        {
            AccountService.Update(editingAccount.Id, editingAccount);
        }

        CloseDialog();
        LoadData();
    }

    private void DeleteAccount(int id)
    {
        AccountService.Delete(id);
        LoadData();
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingAccount = null;
    }
}
