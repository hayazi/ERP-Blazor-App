@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject ERPBlazorApp.AAA.Auth.AuthService AuthService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @if (!Collapsed)
        {
            <a class="navbar-brand" href="">ERPBlazorApp</a>
        }
        <button title="Toggle sidebar" class="btn btn-link text-white" @onclick="ToggleSidebar">
            <span class="oi @(Collapsed ? "oi-menu" : "oi-arrow-left")" aria-hidden="true"></span>
        </button>
        @if (AuthService.IsAuthenticated && !Collapsed)
        {
            <div class="ms-auto d-flex align-items-center" >
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="me-1" />
                <span class="small" >@AuthService.CurrentUser?.Username</span>
            </div>
        }
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Home"]</span> }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <div class="nav-link-wrapper">
                <a class="nav-link flex-grow-1" href="javascript:void(0)" @onclick="ToggleHRSubMenu">
                    <span class="oi oi-people" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["HumanResource"]</span> }
                </a>
                @if (!Collapsed)
                {
                    <span class="nav-chevron @(collapseHRSubMenu ? "collapsed" : null)" @onclick="ToggleHRSubMenu">
                        <span class="oi oi-chevron-bottom" aria-hidden="true"></span>
                    </span>
                }
            </div>
            <div class="nav-submenu @HrNavMenuCssClass">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="hr/employees">
                        <span class="oi oi-person" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Employees"]</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="hr/departments">
                        <span class="oi oi-briefcase" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Departments"]</span> }
                    </NavLink>
                </div>
            </div>
        </div>
        <div class="nav-item px-3">
            <div class="nav-link-wrapper">
                <a class="nav-link flex-grow-1" href="javascript:void(0)" @onclick="ToggleInventorySubMenu">
                    <span class="oi oi-box" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Inventory"]</span> }
                </a>
                @if (!Collapsed)
                {
                    <span class="nav-chevron @(collapseInventorySubMenu ? "collapsed" : null)" @onclick="ToggleInventorySubMenu">
                        <span class="oi oi-chevron-bottom" aria-hidden="true"></span>
                    </span>
                }
            </div>
            <div class="nav-submenu @InventoryNavMenuCssClass">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="inventory/products">
                        <span class="oi oi-tag" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Products"]</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="inventory/inbounds">
                        <span class="oi oi-arrow-right" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Inbounds"]</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="inventory/outbounds">
                        <span class="oi oi-arrow-left" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Outbounds"]</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="inventory/kardex">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Kardex"]</span> }
                    </NavLink>
                </div>
            </div>
        </div>
        <div class="nav-item px-3">
            <div class="nav-link-wrapper">
                <a class="nav-link flex-grow-1" href="javascript:void(0)" @onclick="ToggleCRMSubMenu">
                    <span class="oi oi-star" aria-hidden="true"></span> @if (!Collapsed) { <span>CRM</span> }
                </a>
                @if (!Collapsed)
                {
                    <span class="nav-chevron @(collapseCRMSubMenu ? "collapsed" : null)" @onclick="ToggleCRMSubMenu">
                        <span class="oi oi-chevron-bottom" aria-hidden="true"></span>
                    </span>
                }
            </div>
            <div class="nav-submenu @CRMNavMenuCssClass">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="crm/leads">
                        <span class="oi oi-person" aria-hidden="true"></span> @if (!Collapsed) { <span>Leads</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="crm/customers">
                        <span class="oi oi-briefcase" aria-hidden="true"></span> @if (!Collapsed) { <span>Customers</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="crm/opportunities">
                        <span class="oi oi-arrow-right" aria-hidden="true"></span> @if (!Collapsed) { <span>Opportunities</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="crm/activities">
                        <span class="oi oi-calendar" aria-hidden="true"></span> @if (!Collapsed) { <span>Activities</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="crm/campaigns">
                        <span class="oi oi-pie-chart" aria-hidden="true"></span> @if (!Collapsed) { <span>Campaigns</span> }
                    </NavLink>
                </div>
            </div>
        </div>
        <div class="nav-item px-3">
            <div class="nav-link-wrapper">
                <a class="nav-link flex-grow-1" href="javascript:void(0)" @onclick="ToggleSaleSubMenu">
                    <span class="oi oi-cart" aria-hidden="true"></span> @if (!Collapsed) { <span>Sale</span> }
                </a>
                @if (!Collapsed)
                {
                    <span class="nav-chevron @(collapseSaleSubMenu ? "collapsed" : null)" @onclick="ToggleSaleSubMenu">
                        <span class="oi oi-chevron-bottom" aria-hidden="true"></span>
                    </span>
                }
            </div>
            <div class="nav-submenu @SaleNavMenuCssClass">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="sale/sales">
                        <span class="oi oi-document" aria-hidden="true"></span> @if (!Collapsed) { <span>Sales</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="sale/payments">
                        <span class="oi oi-credit-card" aria-hidden="true"></span> @if (!Collapsed) { <span>Payments</span> }
                    </NavLink>
                </div>
            </div>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="hangfire" target="_blank">
                <span class="oi oi-cog" aria-hidden="true"></span> @if (!Collapsed) { <span>Background Jobs</span> }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <div class="nav-link-wrapper">
                <a class="nav-link flex-grow-1" href="javascript:void(0)" @onclick="ToggleAAASubMenu">
                    <span class="oi oi-lock-locked" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["AAA"]</span> }
                </a>
                @if (!Collapsed)
                {
                    <span class="nav-chevron @(collapseAAASubMenu ? "collapsed" : null)" @onclick="ToggleAAASubMenu">
                        <span class="oi oi-chevron-bottom" aria-hidden="true"></span>
                    </span>
                }
            </div>
            <div class="nav-submenu @AAANavMenuCssClass">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="aaa/users">
                        <span class="oi oi-person" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Users"]</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="aaa/roles">
                        <span class="oi oi-briefcase" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Roles"]</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="aaa/permissions">
                        <span class="oi oi-key" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Permissions"]</span> }
                    </NavLink>
                </div>
                <!-- <div class="nav-item px-3">
                    <NavLink class="nav-link" href="aaa/accounts">
                        <span class="oi oi-book" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Accounting"]</span> }
                    </NavLink>
                </div> 
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="aaa/transactions">
                        <span class="oi oi-transfer" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["JournalEntries"]</span> }
                    </NavLink>
                </div> -->
            </div>
        </div>
        <div class="nav-item px-3">
            <div class="nav-link-wrapper">
                <a class="nav-link flex-grow-1" href="javascript:void(0)" @onclick="ToggleAccountingSubMenu">
                    <span class="oi oi-book" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Accounting"]</span> }
                </a>
                @if (!Collapsed)
                {
                    <span class="nav-chevron @(collapseAccountingSubMenu ? "collapsed" : null)" @onclick="ToggleAccountingSubMenu">
                        <span class="oi oi-chevron-bottom" aria-hidden="true"></span>
                    </span>
                }
            </div>
            <div class="nav-submenu @AccountingNavMenuCssClass">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/chart-of-accounts">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["ChartOfAccounts"]</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/journal-entries">
                        <span class="oi oi-transfer" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["JournalEntries"]</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/trial-balance">
                        <span class="oi oi-calculator" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["TrialBalance"]</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/fiscal-years">
                        <span class="oi oi-calendar" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["FiscalYears"]</span> }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/budgets">
                        <span class="oi oi-pie-chart" aria-hidden="true"></span> @if (!Collapsed) { <span>@L["Budgets"]</span> }
                    </NavLink>
                </div>
            </div>
        </div>
        <div class="nav-item px-3 mt-3">
            @if (AuthService.IsAuthenticated)
            {
                <div class="d-flex align-items-center">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="me-2" Size="Size.Small" />
                    <span>@AuthService.CurrentUser?.Username</span>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Color="Color.Error" OnClick="HandleLogout" Title="Logout" />
                </div>
            }
            else
            {
                <NavLink class="nav-link" href="login">
                    <span class="oi oi-person" aria-hidden="true"></span> @if (!Collapsed) { <span>Login</span> }
                </NavLink>
            }
        </div>
    </nav>
</div>

@code {
    [Parameter]
    public bool Collapsed { get; set; }

    [Parameter]
    public EventCallback OnSidebarToggle { get; set; }

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private bool collapseHRSubMenu = true;

    private string? HrNavMenuCssClass => collapseHRSubMenu ? "collapse" : null;

    private bool collapseInventorySubMenu = true;

    private string? InventoryNavMenuCssClass => collapseInventorySubMenu ? "collapse" : null;

    private bool collapseAAASubMenu = true;

    private string? AAANavMenuCssClass => collapseAAASubMenu ? "collapse" : null;

    private bool collapseAccountingSubMenu = true;

    private string? AccountingNavMenuCssClass => collapseAccountingSubMenu ? "collapse" : null;

    private bool collapseCRMSubMenu = true;

    private string? CRMNavMenuCssClass => collapseCRMSubMenu ? "collapse" : null;

    private bool collapseSaleSubMenu = true;

    private string? SaleNavMenuCssClass => collapseSaleSubMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task ToggleSidebar()
    {
        await OnSidebarToggle.InvokeAsync();
    }

    private void ToggleHRSubMenu()
    {
        collapseHRSubMenu = !collapseHRSubMenu;
    }

    private void ToggleInventorySubMenu()
    {
        collapseInventorySubMenu = !collapseInventorySubMenu;
    }

    private void ToggleAAASubMenu()
    {
        collapseAAASubMenu = !collapseAAASubMenu;
    }

    private void ToggleAccountingSubMenu()
    {
        collapseAccountingSubMenu = !collapseAccountingSubMenu;
    }

    private void ToggleCRMSubMenu()
    {
        collapseCRMSubMenu = !collapseCRMSubMenu;
    }

    private void ToggleSaleSubMenu()
    {
        collapseSaleSubMenu = !collapseSaleSubMenu;
    }

    private void HandleLogout()
    {
        AuthService.Logout();
    }

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}