@page "/accounting/fiscal-years"
@using ERPBlazorApp.Accounting.Services
@using ERPBlazorApp.Accounting.Models
@using MudBlazor
@inject FiscalYearService FiscalYearService

<PageTitle>Fiscal Years</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <MudText Typo="Typo.h6">Fiscal Years</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddFiscalYear">Add Fiscal Year</MudButton>
            </div>

            @if (fiscalYears == null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                <MudDataGrid T="FiscalYear" Items="fiscalYears" Filterable="true" ShowColumnOptions="true" Sortable="true" EditMode="DataGridEditMode.Cell">
                    <Columns>
                        <PropertyColumn T="FiscalYear" TProperty="int" Property="x => x.Id" Title="ID" />
                        <PropertyColumn T="FiscalYear" TProperty="string" Property="x => x.Name" Title="Name" />
                        <PropertyColumn T="FiscalYear" TProperty="DateTime" Property="x => x.StartDate" Title="Start Date" />
                        <PropertyColumn T="FiscalYear" TProperty="DateTime" Property="x => x.EndDate" Title="End Date" />
                        <PropertyColumn T="FiscalYear" TProperty="bool" Property="x => x.IsActive" Title="Active">
                            <CellTemplate Context="fy">
                                <MudBadge Color="fy.Item.IsActive ? Color.Success : Color.Error" Content="@(fy.Item.IsActive ? "Active" : "Inactive")" />
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn T="FiscalYear" TProperty="bool" Property="x => x.IsClosed" Title="Closed">
                            <CellTemplate Context="fy">
                                <MudBadge Color="fy.Item.IsClosed ? Color.Warning : Color.Info" Content="@(fy.Item.IsClosed ? "Closed" : "Open")" />
                            </CellTemplate>
                        </PropertyColumn>
                        <TemplateColumn T="FiscalYear" Title="Actions">
                            <CellTemplate Context="fy">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditFiscalYear(fy.Item)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteFiscalYear(fy.Item.Id)" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager PageSizeOptions="new int[] { 5, 10, 20 }" />
                    </PagerContent>
                </MudDataGrid>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@if (showDialog)
{
    <div class="modal" style="display:block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingFiscalYear == null ? "Add" : "Edit") Fiscal Year</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="editingFiscalYear!.Name" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Start Date</label>
                                <input class="form-control" type="date" @bind="editingFiscalYear!.StartDate" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">End Date</label>
                                <input class="form-control" type="date" @bind="editingFiscalYear!.EndDate" />
                            </div>
                        </div>
                    </div>
                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" @bind="editingFiscalYear!.IsActive" id="activeCheck" />
                        <label class="form-check-label" for="activeCheck">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveFiscalYear">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<FiscalYear>? fiscalYears;
    private bool showDialog = false;
    private FiscalYear? editingFiscalYear;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        fiscalYears = await FiscalYearService.GetAllAsync();
    }

    private void AddFiscalYear()
    {
        editingFiscalYear = new FiscalYear();
        showDialog = true;
    }

    private void EditFiscalYear(FiscalYear fiscalYear)
    {
        editingFiscalYear = new FiscalYear
        {
            Id = fiscalYear.Id,
            Name = fiscalYear.Name,
            StartDate = fiscalYear.StartDate,
            EndDate = fiscalYear.EndDate,
            IsActive = fiscalYear.IsActive,
            IsClosed = fiscalYear.IsClosed
        };
        showDialog = true;
    }

    private async Task SaveFiscalYear()
    {
        if (editingFiscalYear == null) return;

        if (editingFiscalYear.Id == 0)
        {
            await FiscalYearService.AddAsync(editingFiscalYear);
        }
        else
        {
            await FiscalYearService.UpdateAsync(editingFiscalYear.Id, editingFiscalYear);
        }

        CloseDialog();
        await LoadData();
    }

    private async Task DeleteFiscalYear(int id)
    {
        await FiscalYearService.DeleteAsync(id);
        await LoadData();
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingFiscalYear = null;
    }
}
