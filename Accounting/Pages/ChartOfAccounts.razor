@page "/accounting/chart-of-accounts"
@using ERPBlazorApp.Accounting.Services
@using ERPBlazorApp.Accounting.Models
@using MudBlazor
@inject ChartOfAccountService ChartOfAccountService

<PageTitle>Chart of Accounts</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <MudText Typo="Typo.h6">Chart of Accounts</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddAccount">Add Account</MudButton>
            </div>

            @if (accounts == null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                <MudTreeView T="ChartOfAccount" Items="treeItems" SelectedValueChanged="OnAccountSelected">
                    <ItemTemplate>
                        <MudTreeViewItem Items="@context.Children" Value="@context.Value">
                            <Content>
                                <div class="d-flex justify-content-between align-items-center" style="width: 100%;">
                                    <div>
                                        <MudText Typo="Typo.body1">@context.Value.Code - @context.Value.Name</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Default">@context.Value.Type</MudText>
                                    </div>
                                    <div>
                                        <MudBadge Color="context.Value.IsActive ? Color.Success : Color.Error" Content="@(context.Value.IsActive ? "Active" : "Inactive")" Class="me-2" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAccount(context.Value)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAccount(context.Value.Id)" />
                                    </div>
                                </div>
                            </Content>
                        </MudTreeViewItem>
                    </ItemTemplate>
                </MudTreeView>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@if (showDialog)
{
    <div class="modal" style="display:block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingAccount == null ? "Add" : "Edit") Account</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input class="form-control" @bind="editingAccount!.Code" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="editingAccount!.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select class="form-select" @bind="editingAccount!.Type">
                            <option value="Asset">Asset</option>
                            <option value="Liability">Liability</option>
                            <option value="Equity">Equity</option>
                            <option value="Revenue">Revenue</option>
                            <option value="Expense">Expense</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Parent Account</label>
                        <select class="form-select" @bind="editingAccount!.ParentAccountId">
                            <option value="">None</option>
                            @foreach (var acc in accounts!)
                            {
                                <option value="@acc.Id">@acc.Code - @acc.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" @bind="editingAccount!.IsActive" id="activeCheck" />
                        <label class="form-check-label" for="activeCheck">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveAccount">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ChartOfAccount>? accounts;
    private IReadOnlyCollection<ITreeItemData<ChartOfAccount>> treeItems = Array.Empty<ITreeItemData<ChartOfAccount>>();
    private bool showDialog = false;
    private ChartOfAccount? editingAccount;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        accounts = await ChartOfAccountService.GetAllAsync();
        treeItems = BuildTree(accounts);
    }

    private IReadOnlyCollection<ITreeItemData<ChartOfAccount>> BuildTree(List<ChartOfAccount> flatList)
    {
        var lookup = flatList.ToDictionary(a => a.Id);
        var items = flatList.ToDictionary(a => a.Id, a => new ChartOfAccountTreeItem { Value = a });
        var roots = new List<ITreeItemData<ChartOfAccount>>();

        foreach (var account in flatList)
        {
            if (account.ParentAccountId.HasValue && lookup.ContainsKey(account.ParentAccountId.Value))
            {
                var parent = items[account.ParentAccountId.Value];
                parent.Children = parent.Children.Concat(new[] { items[account.Id] }).ToList();
            }
            else
            {
                roots.Add(items[account.Id]);
            }
        }

        return roots;
    }

    private void OnAccountSelected(ChartOfAccount account)
    {
        EditAccount(account);
    }

    private void AddAccount()
    {
        editingAccount = new ChartOfAccount { IsActive = true };
        showDialog = true;
    }

    private void EditAccount(ChartOfAccount account)
    {
        editingAccount = new ChartOfAccount
        {
            Id = account.Id,
            Code = account.Code,
            Name = account.Name,
            Type = account.Type,
            ParentAccountId = account.ParentAccountId,
            IsActive = account.IsActive
        };
        showDialog = true;
    }

    private async Task SaveAccount()
    {
        if (editingAccount == null) return;

        if (editingAccount.Id == 0)
        {
            await ChartOfAccountService.AddAsync(editingAccount);
        }
        else
        {
            await ChartOfAccountService.UpdateAsync(editingAccount.Id, editingAccount);
        }

        CloseDialog();
        await LoadData();
    }

    private async Task DeleteAccount(int id)
    {
        await ChartOfAccountService.DeleteAsync(id);
        await LoadData();
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingAccount = null;
    }

    private class ChartOfAccountTreeItem : ITreeItemData<ChartOfAccount>
    {
        private List<ITreeItemData<ChartOfAccount>> _children = new List<ITreeItemData<ChartOfAccount>>();
        
        public ChartOfAccount Value { get; set; } = new ChartOfAccount();
        public IReadOnlyCollection<ITreeItemData<ChartOfAccount>> Children { get => _children; set => _children = value.ToList(); }
        public string Text { get; set; } = string.Empty;
        public string? Icon { get; set; }
        public bool Expanded { get; set; }
        public bool Expandable { get; set; }
        public bool Selected { get; set; }
        public bool Visible { get; set; } = true;
        public bool HasChildren => _children.Count > 0;
    }
}
