@page "/accounting/chart-of-accounts"
@using ERPBlazorApp.Accounting.Services
@using ERPBlazorApp.Accounting.Models
@using ERPBlazorApp.Accounting.Shared
@using MudBlazor
@inject ChartOfAccountService ChartOfAccountService

<PageTitle>Chart of Accounts</PageTitle>

<MudGrid>
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <MudText Typo="Typo.h6">Account Structure</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CreateAccount">Create Account</MudButton>
            </div>
            @if (accounts == null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                @foreach (var account in rootAccounts)
                {
                    <ChartOfAccountTreeNode Node="@account" OnSelect="OnAccountSelected" OnEdit="EditAccount" OnDelete="DeleteAccount" />
                }
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">
                @(selectedAccount == null ? "Select an account to view details" : $"{selectedAccount.Code} - {selectedAccount.Name}")
            </MudText>
            @if (selectedAccount != null)
            {
                <MudDataGrid T="ChartOfAccount" Items="selectedAccount.ChildAccounts" Filterable="true" ShowColumnOptions="true" Sortable="true" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn T="ChartOfAccount" TProperty="int" Property="x => x.Id" Title="ID" />
                        <PropertyColumn T="ChartOfAccount" TProperty="string" Property="x => x.Code" Title="Code" />
                        <PropertyColumn T="ChartOfAccount" TProperty="string" Property="x => x.Name" Title="Name" />
                        <PropertyColumn T="ChartOfAccount" TProperty="string" Property="x => x.Type" Title="Type" />
                        <PropertyColumn T="ChartOfAccount" TProperty="bool" Property="x => x.IsActive" Title="Active">
                            <CellTemplate Context="account">
                                <MudBadge Color="account.Item.IsActive ? Color.Success : Color.Error" Content="@(account.Item.IsActive ? "Active" : "Inactive")" />
                            </CellTemplate>
                        </PropertyColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager PageSizeOptions="new int[] { 5, 10, 20 }" />
                    </PagerContent>
                </MudDataGrid>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@if (showDialog)
{
    <div class="modal" style="display:block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingAccount == null ? "Add" : "Edit") Account</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input class="form-control" @bind="editingAccount!.Code" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="editingAccount!.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select class="form-select" @bind="editingAccount!.Type">
                            <option value="Asset">Asset</option>
                            <option value="Liability">Liability</option>
                            <option value="Equity">Equity</option>
                            <option value="Revenue">Revenue</option>
                            <option value="Expense">Expense</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Parent Account</label>
                        <select class="form-select" @bind="editingAccount!.ParentAccountId">
                            <option value="">None</option>
                            @foreach (var acc in accounts!)
                            {
                                <option value="@acc.Id">@acc.Code - @acc.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" @bind="editingAccount!.IsActive" id="activeCheck" />
                        <label class="form-check-label" for="activeCheck">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveAccount">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ChartOfAccount>? accounts;
    private List<ChartOfAccount> rootAccounts = new();
    private ChartOfAccount? selectedAccount;
    private bool showDialog = false;
    private ChartOfAccount? editingAccount;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        accounts = await ChartOfAccountService.GetAllAsync();
        rootAccounts = accounts!.Where(a => !a.ParentAccountId.HasValue).ToList();
    }

    private void CreateAccount()
    {
        editingAccount = new ChartOfAccount { IsActive = true };
        showDialog = true;
    }

    private void OnAccountSelected(ChartOfAccount account)
    {
        selectedAccount = account;
        StateHasChanged();
    }

    private void EditAccount(ChartOfAccount account)
    {
        editingAccount = new ChartOfAccount
        {
            Id = account.Id,
            Code = account.Code,
            Name = account.Name,
            Type = account.Type,
            ParentAccountId = account.ParentAccountId,
            IsActive = account.IsActive
        };
        showDialog = true;
    }

    private async Task SaveAccount()
    {
        if (editingAccount == null) return;

        if (editingAccount.Id == 0)
        {
            await ChartOfAccountService.AddAsync(editingAccount);
        }
        else
        {
            await ChartOfAccountService.UpdateAsync(editingAccount.Id, editingAccount);
        }

        CloseDialog();
        await LoadData();
    }

    private async Task DeleteAccount(int id)
    {
        await ChartOfAccountService.DeleteAsync(id);
        if (selectedAccount?.Id == id)
        {
            selectedAccount = null;
        }
        await LoadData();
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingAccount = null;
    }
}
